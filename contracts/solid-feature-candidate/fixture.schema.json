{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://crawler.local/contracts/solid-feature-candidate/fixture.schema.json",
  "title": "Crawler solid-feature qualification fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "story_ids", "description", "units", "input", "expected", "tolerances", "identity_sets", "lifecycle_steps", "evidence_test_ids", "legacy_provenance"],
  "allOf": [
    {
      "if": {
        "properties": { "fixture_id": { "const": "production-single-target-cut-lifecycle" } },
        "required": ["fixture_id"]
      },
      "then": {
        "properties": {
          "expected": {
            "type": "object",
            "properties": {
              "kind": { "const": "success" },
              "result": {
                "type": "object",
                "required": ["actual_tool_entry_parity", "removal_volume_distinguished", "stale_preview_rejected", "stale_basis_atomic", "upstream_dimension_recomputed", "worker_refusal_atomic"],
                "properties": {
                  "actual_tool_entry_parity": { "const": true },
                  "removal_volume_distinguished": { "const": true },
                  "stale_preview_rejected": { "const": true },
                  "stale_basis_atomic": { "const": true },
                  "upstream_dimension_recomputed": { "const": true },
                  "worker_refusal_atomic": { "const": true }
                }
              }
            },
            "required": ["kind", "result"]
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "fixture_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "story_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^E3D-S[1-9][0-9]*-[0-9]{2}$" } },
    "description": { "type": "string", "minLength": 1 },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "angle"],
      "properties": { "length": { "const": "nanometer" }, "angle": { "const": "radian" } }
    },
    "input": {
      "type": "object",
      "required": ["schema_version", "kind", "payload"],
      "properties": {
        "schema_version": { "type": "integer", "minimum": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    },
    "expected": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "result"],
          "properties": { "kind": { "const": "success" }, "result": { "type": "object" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "error"],
          "properties": {
            "kind": { "const": "structured_error" },
            "oracle_assertions": { "type": "object" },
            "error": {
              "type": "object", "additionalProperties": false,
              "required": ["category", "code", "field_path", "referenced_entity_ids"],
              "properties": {
                "category": { "type": "string", "minLength": 1 },
                "code": { "type": "string", "minLength": 1 },
                "field_path": { "type": "string" },
                "referenced_entity_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
              }
            }
          }
        }
      ]
    },
    "tolerances": {
      "type": "object", "additionalProperties": false,
      "required": ["relative", "aabb_nm", "signed_volume_nm3", "surface_area_nm2", "centroid_nm"],
      "properties": {
        "relative": { "type": "number", "minimum": 0 },
        "aabb_nm": { "type": "number", "minimum": 0 },
        "signed_volume_nm3": { "type": "number", "minimum": 0 },
        "surface_area_nm2": { "type": "number", "minimum": 0 },
        "centroid_nm": { "type": "number", "minimum": 0 }
      }
    },
    "identity_sets": {
      "type": "object", "additionalProperties": false,
      "required": ["retained", "replaced"],
      "properties": {
        "retained": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "replaced": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "lifecycle_steps": {
      "type": "array", "minItems": 1,
      "items": { "enum": ["authority_validate", "preview", "cancel", "commit", "edit", "suppress", "unsuppress", "undo", "redo", "save", "reload", "recompute", "repair", "migrate", "reopen", "load"] }
    },
    "evidence_test_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "legacy_provenance": {
      "type": ["object", "null"],
      "properties": {
        "source_schema_version": { "type": "integer", "minimum": 1 },
        "disposition": { "enum": ["preserve_v1", "migrate_v1_to_v2", "open_read_only"] },
        "source_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  }
}
