{
  "schema_version": 1,
  "id": "crawler.part.extrude",
  "label": "Extrude",
  "group": "part_design",
  "output_kind": "body",
  "input_slots": [
    {
      "key": "profile",
      "label": "Profile",
      "allowed_kinds": ["sketch_profile"],
      "minimum_count": 1,
      "maximum_count": 1
    },
    {
      "key": "target_body",
      "label": "Target body",
      "allowed_kinds": ["body"],
      "minimum_count": 0,
      "maximum_count": 1
    }
  ],
  "parameters": [
    {
      "key": "distance",
      "label": "Distance",
      "value_kind": "length_nanometers",
      "default": { "kind": "length_nanometers", "value": 10000000 },
      "bounds": { "minimum": 1000, "maximum": 1000000000000 },
      "choices": [],
      "advanced_group": null
    },
    {
      "key": "direction",
      "label": "Direction",
      "value_kind": "text",
      "default": { "kind": "text", "value": "positive" },
      "bounds": null,
      "choices": ["positive", "negative", "symmetric"],
      "advanced_group": null
