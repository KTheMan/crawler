{
  "name": "crawler-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "test": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "test:unit": "node --experimental-strip-types --test unit/*.test.ts",
    "test:advanced": "node --experimental-strip-types --test unit/advanced-feature-builder.test.ts",
    "test:sketch": "node --experimental-strip-types --test unit/sketch-editor.test.ts"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/three": "^0.181.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
